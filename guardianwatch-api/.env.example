# Copy this to `.env` and fill in real values. Nothing here is loaded
# automatically in production — Cloud Run (or wherever this deploys) should
# get these as real environment variables / secrets, not a checked-in file.

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=GuardianWrist API
ENV=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────
# Local dev default (zero setup, a file in the project root):
DATABASE_URL=sqlite+aiosqlite:///./guardianwrist.db
# Production (Cloud SQL for Postgres, or any Postgres instance):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/guardianwrist
DATABASE_ECHO=false

# ── Auth ─────────────────────────────────────────────────────────────────
# Must match the Firebase project in firebase_options.dart.
FIREBASE_PROJECT_ID=guardianwatch-b1972
# Path to a service-account JSON key. Leave unset to use Application
# Default Credentials instead (the right choice on Cloud Run with a
# service account attached to the instance).
FIREBASE_CREDENTIALS_PATH=

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ── Admin panel auth ───────────────────────────────────────────────────
# Deliberately separate from JWT_SECRET_KEY above — see models/admin_user.py.
# Generate independently:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET_KEY=dev-only-insecure-admin-secret-change-me
ADMIN_JWT_EXPIRE_MINUTES=720

# ── Payments (Stripe) ───────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys — nothing
# charges real money until these are live-mode keys.
STRIPE_SECRET_KEY=
# From the webhook endpoint you register in the Stripe dashboard
# (Developers → Webhooks → add endpoint → <your-api>/webhooks/stripe),
# or from `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=
# The deployed company site's URL — Stripe Checkout redirects here after
# payment. No trailing slash.
FRONTEND_URL=http://localhost:5173

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list is NOT supported directly by pydantic-settings for
# a List[str] field via a plain env var — set this as a JSON array string:
# CORS_ORIGINS=["https://yourdomain.com"]
CORS_ORIGINS=["*"]

# ── IAP receipt verification (see services/receipt_service.py) ───────────
APPLE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_PACKAGE_NAME=com.circumnet.guardianwrist

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=120/minute
